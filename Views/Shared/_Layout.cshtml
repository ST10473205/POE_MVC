<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay Portal</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts for Energetic Typography -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome for Sporting Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --raceday-primary: #FF5722;
            --raceday-dark: #121619;
            --raceday-card-bg: #1E252B;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f4f6f8;
            color: #333;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .navbar-custom {
            background-color: var(--raceday-dark);
            border-bottom: 3px solid var(--raceday-primary);
        }

        .navbar-brand {
            color: #fff !important;
            font-size: 1.5rem;
        }

            .navbar-brand span {
                color: var(--raceday-primary);
            }

        .btn-raceday {
            background-color: var(--raceday-primary);
            color: #fff;
            font-weight: 600;
            border: none;
            transition: opacity 0.2s;
        }

            .btn-raceday:hover {
                background-color: #e64a19;
                color: #fff;
            }

        footer {
            background-color: var(--raceday-dark);
            color: #aaa;
            border-top: 1px solid #2c343d;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    @{
        var sessionUser = Context.Session.GetString("Username");
        bool isLoggedIn = !string.IsNullOrEmpty(sessionUser) || (User.Identity != null && User.Identity.IsAuthenticated);
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm py-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-person-running me-2"></i>Race<span>Day</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index"><i class="fa-solid fa-calendar-days me-1"></i> Explore Events</a>
                        </li>

                        @if (isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Results" asp-action="Index"><i class="fa-solid fa-trophy me-1"></i> My Results</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Index"><i class="fa-solid fa-user me-1"></i> My Profile</a>
                            </li>
                        }

                        @if (User.IsInRole("Organiser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard"><i class="fa-solid fa-gauge me-1"></i> Organiser Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="ManageEvents"><i class="fa-solid fa-list-check me-1"></i> Manage Events</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (isLoggedIn)
                        {
                            <li class="nav-item me-3 text-light">
                                <small class="text-white-50">Hello,</small> <strong>@(sessionUser ?? User.Identity?.Name)</strong>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm px-3" asp-controller="Account" asp-action="Logout">Sign Out</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        <!-- Global TempData Alert Messages for Graceful Feedback -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="text-center py-4 mt-auto">
        <div class="container">
            <p class="mb-0 small">&copy; 2026 RaceDay Portal. All rights reserved.</p>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>