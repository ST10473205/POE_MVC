@model POE_MVC.Models.CreateEnrolmentViewModel
@{
    ViewData["Title"] = "Register for Event";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 my-4">
            <div class="card-header bg-dark text-white py-3">
                <h4 class="mb-0"><i class="fa-solid fa-file-pen text-primary me-2"></i>Complete Your Enrolment</h4>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <form asp-action="Enrol" method="post">
                    <input type="hidden" asp-for="EventId" />

                    <div class="mb-3">
                        <label asp-for="CategoryName" class="form-label fw-semibold">Select Race Category</label>
                        <select asp-for="CategoryName" class="form-select">
                            <option value="">-- Choose Category --</option>
                            <option value="5km Fun Walk">5km Fun Walk</option>
                            <option value="10km Open">10km Open</option>
                            <option value="21km Half Marathon">21km Half Marathon</option>
                        </select>
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EmergencyContact" class="form-label fw-semibold">Emergency Contact Number</label>
                        <input asp-for="EmergencyContact" class="form-control" placeholder="e.g. 082 123 4567" />
                        <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-check me-1"></i> Confirm Enrolment</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}