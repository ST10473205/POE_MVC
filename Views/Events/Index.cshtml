@model IEnumerable<POE_MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Event Catalog";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Upcoming Race Events</h2>
        @if (Context.Session.GetString("Role") == "Organiser")
        {
            <a asp-action="Create" class="btn btn-success">+ Create New Event</a>
        }
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <!-- Fixed height from 1800px to 180px -->
                        <img src="@item.ImageUrl" class="card-img-top" alt="Event Banner" style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <img src="~/images/banner.jpg" class="card-img-top" alt="Event Banner" style="height: 180px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Title</h5>
                        <p class="card-text text-muted small">@item.Description</p>
                        <ul class="list-unstyled mt-auto mb-3">
                            <li><strong>Date:</strong> @item.EventDate.ToString("yyyy-MM-dd")</li>
                            <li><strong>Location:</strong> @item.Location</li>
                            <li><strong>Distance:</strong> @item.DistanceKm km</li>
                        </ul>

                        <!-- Action buttons for viewing and enrolling -->
                        <div class="d-grid gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                            <a asp-action="Enrol" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                <i class="fa-solid fa-person-running me-1"></i> Enrol Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>