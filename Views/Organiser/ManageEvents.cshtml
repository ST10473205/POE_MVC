@model IEnumerable<POE_MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Race Events</h2>
        <a class="btn btn-success" asp-controller="Events" asp-action="Create">
            <i class="fa-solid fa-plus me-1"></i> Create Event
        </a>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Title</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distance</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.Title</td>
                                    <td>@item.EventDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@item.Location</td>
                                    <td>@item.DistanceKm km</td>
                                    <td class="text-end pe-4">
                                        <a class="btn btn-sm btn-outline-primary me-1" asp-controller="Events" asp-action="Details" asp-route-id="@item.Id">View</a>
                                        <a class="btn btn-sm btn-outline-danger" asp-controller="Events" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-folder-open fs-2 mb-2 d-block"></i>
                                    No events found. Click "Create Event" to get started!
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>