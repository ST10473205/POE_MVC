@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="p-5 text-white rounded bg-dark shadow-sm border-start border-5" style="border-color: var(--raceday-primary) !important;">
                <h1 class="display-5 fw-bold">Organiser Dashboard</h1>
                <p class="lead text-white-50">Welcome back! Manage your upcoming race events, monitor participant sign-ups, and publish new activities.</p>
                <hr class="my-4 bg-secondary">
                <div class="d-flex gap-3">
                    <a class="btn btn-raceday btn-lg px-4" asp-controller="Events" asp-action="Create">
                        <i class="fa-solid fa-plus me-2"></i>Create New Event
                    </a>
                    <a class="btn btn-outline-light btn-lg px-4" asp-controller="Organiser" asp-action="ManageEvents">
                        <i class="fa-solid fa-list-check me-2"></i>Manage Events
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <div class="text-primary fs-1 mb-2"><i class="fa-solid fa-calendar-check"></i></div>
                    <h5 class="card-title text-muted">Active Events</h5>
                    <h3 class="fw-bold">2</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <div class="text-success fs-1 mb-2"><i class="fa-solid fa-users"></i></div>
                    <h5 class="card-title text-muted">Total Enrolments</h5>
                    <h3 class="fw-bold">48</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body text-center py-4">
                    <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-flag-checkered"></i></div>
                    <h5 class="card-title text-muted">Completed Races</h5>
                    <h3 class="fw-bold">5</h3>
                </div>
            </div>
        </div>
    </div>
</div>